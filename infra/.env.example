# PostgreSQL / PostGIS
POSTGRES_USER=webatlas
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=webatlas
POSTGRES_PORT=5432

# GeoServer
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change_me_dev
GEOSERVER_PORT=8080

# Read-only DB role the assistant SQL escape hatch connects as.
ASSISTANT_DB_PASSWORD=change_me_dev

# Only for a second clone on the same machine: its own containers and volumes (and its own ports above).
# See docs/runbooks/README.md, "A second stack on one machine".
# COMPOSE_PROJECT_NAME=webatlas_second

# Platform stack (infra/docker-compose.platform.yml; infra/platform/README.md). Local dev values only.
KC_ADMIN_PASSWORD=change_me_dev
KC_WEBATLAS_API_SECRET=change_me_dev_api_client
KC_GEONODE_SECRET=change_me_dev_geonode_client
KC_DAGSTER_SECRET=change_me_dev_dagster_client
KC_DEV_USERNAME=demo
# An existing WebATLAS admin's email: the first SSO sign-in links the accounts by it.
KC_DEV_EMAIL=demo@webatlas.local
KC_DEV_PASSWORD=change_me_dev
GEONODE_DB_PASSWORD=change_me_dev
GEONODE_DATA_DB_PASSWORD=change_me_dev
GEONODE_SECRET_KEY=change_me_dev_geonode_secret_key
GEONODE_ADMIN_PASSWORD=change_me_dev
ORCHESTRATOR_DB_PASSWORD=change_me_dev
# Role webatlas_mosaic: the ImageMosaic granule index database webatlas_mosaic_index.
MOSAIC_INDEX_DB_PASSWORD=change_me_dev
# Exactly 32 characters.
OAUTH2_PROXY_COOKIE_SECRET=change_me_dev_32_chars_exactly__
