# PostgreSQL / PostGIS
POSTGRES_USER=webatlas
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=webatlas
POSTGRES_PORT=5432

# GeoServer
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change_me_dev
GEOSERVER_PORT=8080

# Read-only DB role the assistant SQL escape hatch connects as.
ASSISTANT_DB_PASSWORD=change_me_dev

# Only for a second clone on the same machine: its own containers and volumes (and its own ports above).
# See docs/runbooks/README.md, "A second stack on one machine".
# COMPOSE_PROJECT_NAME=webatlas_second
