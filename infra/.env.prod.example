# Cấu hình triển khai — chép thành infra/.env.prod trên máy chủ rồi điền.
# KHÁC infra/.env của máy dev: mọi mật khẩu ở đây phải là giá trị thật, sinh ngẫu nhiên.
# Sinh nhanh:  openssl rand -base64 24

# --- Tên miền ---------------------------------------------------------------------
# Địa chỉ Caddy lắng nghe. Là tên miền thì Caddy tự xin chứng chỉ Let's Encrypt.
# Chưa có tên miền: dùng nip.io với IP công khai của máy, ví dụ 203-0-113-7.nip.io —
# nó phân giải đúng về IP đó và Let's Encrypt cấp chứng chỉ cho nó bình thường.
# Muốn chạy thuần HTTP (không TLS) thì đặt là  :80
SITE_ADDRESS=atlas.example.com
# Cùng địa chỉ trên, kèm scheme. API dùng làm CORS_ORIGIN.
SITE_URL=https://atlas.example.com

# --- PostgreSQL / PostGIS ---------------------------------------------------------
POSTGRES_USER=webatlas
POSTGRES_PASSWORD=
POSTGRES_DB=webatlas
POSTGRES_PORT=5432

# --- GeoServer --------------------------------------------------------------------
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=
GEOSERVER_PORT=8080

# --- API --------------------------------------------------------------------------
# Tối thiểu 16 ký tự, env.ts từ chối nếu ngắn hơn.
JWT_SECRET=

# Vai trò chỉ-đọc mà lối thoát SQL của trợ lý dùng để kết nối.
ASSISTANT_DB_PASSWORD=

# --- Trợ lý (tuỳ chọn, CÓ TÍNH PHÍ) -----------------------------------------------
# Để trống thì tab trợ lý trả 503 và phần còn lại của demo chạy bình thường — đây là
# thứ duy nhất trong cả stack không miễn phí.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5
